# Desarrollo local: cambia estas credenciales antes de compartir el entorno.
POSTGRES_DB=convivencia
POSTGRES_USER=convivencia_app
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://convivencia_app:change_this_local_password@db:5432/convivencia?schema=public
SHADOW_DATABASE_URL=postgresql://convivencia_app:change_this_local_password@db:5432/convivencia_shadow?schema=public
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api
SESSION_TTL_HOURS=12
SESSION_LAST_SEEN_UPDATE_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=no-reply@convivencia.example.com
MAILPIT_UI_PORT=8025

# Correo institucional real (Google Workspace o Microsoft 365). En desarrollo se deja vacío y los correos llegan a Mailpit.
# Google: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SECURE=false (STARTTLS) y una contraseña de aplicación.
# Microsoft 365: MAIL_HOST=smtp.office365.com, MAIL_PORT=587, MAIL_SECURE=false (STARTTLS).
# MAIL_FROM debe ser una dirección autorizada para la cuenta. Nunca registre estas credenciales en el repositorio.
# MAIL_USER=usuario-smtp@example.invalid
# MAIL_PASSWORD=contrasena-de-aplicacion-ficticia
