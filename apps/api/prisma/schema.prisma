generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}
model SystemControl {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("system_control")
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String @map("password_hash")
  displayName String @map("display_name")
  isActive Boolean @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  roles UserRole[]
  sessions Session[]
  resetTokens PasswordResetToken[]
  establishmentMemberships EstablishmentMembership[]
  createdCases Case[] @relation("CaseCreator")
  responsibleCases Case[] @relation("CaseResponsible")
  caseAssignments CaseAssignment[] @relation("CaseAssignmentUser")
  caseAssignmentsCreated CaseAssignment[] @relation("CaseAssignmentActor")
  caseEvents CaseEvent[] @relation("CaseEventActor")
  caseAccessGrants CaseAccessGrant[] @relation("CaseAccessUser")
  caseAccessGrantsCreated CaseAccessGrant[] @relation("CaseAccessGrantActor")
  caseReportsCreated CaseReport[] @relation("CaseReportCreator")
  caseParticipantLinks CaseParticipant[] @relation("CaseParticipantLinker")
  interviewsConducted Interview[] @relation("InterviewInterviewer")
  interviewCorrections InterviewCorrection[] @relation("InterviewCorrectionActor")
  documentsUploaded CaseDocument[] @relation("CaseDocumentUploader")
  protocolVersionsCreated ProtocolVersion[] @relation("ProtocolVersionCreator")
  protocolApplicationsCreated CaseProtocolApplication[] @relation("ProtocolApplicationActor")
  measuresCreated CaseMeasure[] @relation("CaseMeasureCreator")
  measureResponsibilities CaseMeasureResponsible[] @relation("CaseMeasureResponsibleUser")
  followUpsCreated CaseFollowUp[] @relation("CaseFollowUpCreator")
  tasksCreated CaseTask[] @relation("CaseTaskCreator")
  tasksAssigned CaseTask[] @relation("CaseTaskAssignee")
  notifications Notification[] @relation("NotificationRecipient")
  @@map("users")
}

enum CaseStatus {
  ABIERTO
  EN_EVALUACION
  EN_PROCESO
  PAUSADO
  RESUELTO
  CERRADO
}

enum CaseAccessLevel {
  READ
  WRITE
}

enum CaseEventType {
  CASE_CREATED
  CASE_UPDATED
  CASE_ASSIGNED
  CASE_STAGE_CHANGED
  CASE_TRANSITIONED
  CASE_PAUSED
  CASE_RESUMED
  CASE_RESOLVED
  CASE_CLOSED
  CASE_REOPENED
  REPORT_CREATED
  REPORT_UPDATED
  PARTICIPANT_LINKED
  PARTICIPANT_UNLINKED
  INTERVIEW_CREATED
  INTERVIEW_FINALIZED
  INTERVIEW_CORRECTED
  DOCUMENT_UPLOADED
  PROTOCOL_APPLIED
  MEASURE_CREATED
  MEASURE_UPDATED
  FOLLOW_UP_CREATED
  TASK_CREATED
  TASK_COMPLETED
  NOTIFICATION_CREATED
}

enum InterviewStatus {
  BORRADOR
  FINALIZADA
}

enum ParticipantKind {
  ESTUDIANTE
  APODERADO
  FUNCIONARIO
  TERCERO
}

enum DocumentKind {
  DOCUMENTO
  EVIDENCIA
}
enum ProtocolVersionStatus {
  BORRADOR
  PUBLICADO
  RETIRADO
}
enum MeasureStatus {
  PENDIENTE
  COMPLETADA
  CANCELADA
}
enum TaskStatus {
  PENDIENTE
  COMPLETADA
  CANCELADA
}

model Establishment {
  id String @id @default(uuid())
  code String @unique
  name String
  institutionalIdentifier String? @unique @map("institutional_identifier")
  isActive Boolean @default(true) @map("is_active")
  nextCaseSequence Int @default(1) @map("next_case_sequence")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  memberships EstablishmentMembership[]
  stages CaseStage[]
  cases Case[]
  reports CaseReport[]
  participants Participant[]
  protocolTemplates ProtocolTemplate[]
  @@map("establishments")
}

model EstablishmentMembership {
  establishmentId String @map("establishment_id")
  userId String @map("user_id")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([establishmentId, userId])
  @@index([userId, isActive])
  @@map("establishment_memberships")
}

model CaseStage {
  id String @id @default(uuid())
  establishmentId String @map("establishment_id")
  code String
  name String
  displayOrder Int @map("display_order")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  currentCases Case[] @relation("CaseCurrentStage")
  @@unique([establishmentId, code])
  @@unique([establishmentId, displayOrder])
  @@map("case_stages")
}

model Case {
  id String @id @default(uuid())
  establishmentId String @map("establishment_id")
  folio Int
  title String
  initialDescription String @map("initial_description")
  receivedAt DateTime @map("received_at")
  categoryCode String @map("category_code")
  priority String
  status CaseStatus @default(ABIERTO)
  currentStageId String? @map("current_stage_id")
  responsibleUserId String? @map("responsible_user_id")
  createdByUserId String @map("created_by_user_id")
  closedAt DateTime? @map("closed_at")
  closureReason String? @map("closure_reason")
  nextAction String? @map("next_action")
  nextActionDueAt DateTime? @map("next_action_due_at")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  currentStage CaseStage? @relation("CaseCurrentStage", fields: [currentStageId], references: [id], onDelete: Restrict)
  responsibleUser User? @relation("CaseResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  createdByUser User @relation("CaseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments CaseAssignment[]
  events CaseEvent[]
  accessGrants CaseAccessGrant[]
  reports CaseReport[]
  participants CaseParticipant[]
  interviews Interview[]
  documents CaseDocument[]
  protocolApplications CaseProtocolApplication[]
  measures CaseMeasure[]
  followUps CaseFollowUp[]
  tasks CaseTask[]
  notifications Notification[]
  @@unique([establishmentId, folio])
  @@index([establishmentId, status, updatedAt])
  @@index([establishmentId, responsibleUserId])
  @@map("cases")
}

model Interview {
  id String @id @default(uuid())
  caseId String @map("case_id")
  interviewerUserId String @map("interviewer_user_id")
  occurredAt DateTime @map("occurred_at")
  modalityCode String @map("modality_code")
  summary String
  restrictedNotes String? @map("restricted_notes")
  agreements String?
  status InterviewStatus @default(BORRADOR)
  version Int @default(1)
  finalizedAt DateTime? @map("finalized_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  interviewer User @relation("InterviewInterviewer", fields: [interviewerUserId], references: [id], onDelete: Restrict)
  corrections InterviewCorrection[]
  @@index([caseId, occurredAt])
  @@map("interviews")
}
model InterviewCorrection {
  id String @id @default(uuid())
  interviewId String @map("interview_id")
  actorUserId String @map("actor_user_id")
  reason String
  previousVersion Int @map("previous_version")
  createdAt DateTime @default(now()) @map("created_at")
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  actor User @relation("InterviewCorrectionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([interviewId, createdAt])
  @@map("interview_corrections")
}

model CaseDocument {
  id String @id @default(uuid())
  caseId String @map("case_id")
  uploadedByUserId String @map("uploaded_by_user_id")
  kind DocumentKind
  originalFilename String @map("original_filename")
  storageKey String @unique @map("storage_key")
  contentType String @map("content_type")
  sizeBytes Int @map("size_bytes")
  sha256 String
  createdAt DateTime @default(now()) @map("created_at")
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  uploadedByUser User @relation("CaseDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  @@index([caseId, createdAt])
  @@map("case_documents")
}

model ProtocolTemplate {
  id String @id @default(uuid())
  establishmentId String @map("establishment_id")
  code String
  name String
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  versions ProtocolVersion[]
  @@unique([establishmentId, code])
  @@map("protocol_templates")
}

model ProtocolVersion {
  id String @id @default(uuid())
  protocolTemplateId String @map("protocol_template_id")
  version Int
  title String
  content Json
  status ProtocolVersionStatus @default(BORRADOR)
  createdByUserId String @map("created_by_user_id")
  publishedAt DateTime? @map("published_at")
  createdAt DateTime @default(now()) @map("created_at")
  protocolTemplate ProtocolTemplate @relation(fields: [protocolTemplateId], references: [id], onDelete: Restrict)
  createdByUser User @relation("ProtocolVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  applications CaseProtocolApplication[]
  @@unique([protocolTemplateId, version])
  @@index([protocolTemplateId, status])
  @@map("protocol_versions")
}

model CaseProtocolApplication {
  id String @id @default(uuid())
  caseId String @map("case_id")
  protocolVersionId String @map("protocol_version_id")
  appliedByUserId String @map("applied_by_user_id")
  appliedAt DateTime @default(now()) @map("applied_at")
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  protocolVersion ProtocolVersion @relation(fields: [protocolVersionId], references: [id], onDelete: Restrict)
  appliedByUser User @relation("ProtocolApplicationActor", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  @@unique([caseId, protocolVersionId])
  @@map("case_protocol_applications")
}

model CaseMeasure {
  id String @id @default(uuid())
  caseId String @map("case_id")
  createdByUserId String @map("created_by_user_id")
  title String
  description String?
  dueAt DateTime? @map("due_at")
  status MeasureStatus @default(PENDIENTE)
  version Int @default(1)
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdByUser User @relation("CaseMeasureCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  responsibles CaseMeasureResponsible[]
  @@index([caseId, status, dueAt])
  @@map("case_measures")
}

model CaseMeasureResponsible {
  measureId String @map("measure_id")
  userId String @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  measure CaseMeasure @relation(fields: [measureId], references: [id], onDelete: Cascade)
  user User @relation("CaseMeasureResponsibleUser", fields: [userId], references: [id], onDelete: Restrict)
  @@id([measureId, userId])
  @@map("case_measure_responsibles")
}

model CaseFollowUp {
  id String @id @default(uuid())
  caseId String @map("case_id")
  createdByUserId String @map("created_by_user_id")
  occurredAt DateTime @map("occurred_at")
  note String
  nextAction String? @map("next_action")
  nextActionDueAt DateTime? @map("next_action_due_at")
  createdAt DateTime @default(now()) @map("created_at")
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdByUser User @relation("CaseFollowUpCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  @@index([caseId, occurredAt])
  @@map("case_follow_ups")
}

model CaseTask {
  id String @id @default(uuid())
  caseId String @map("case_id")
  createdByUserId String @map("created_by_user_id")
  assignedToUserId String? @map("assigned_to_user_id")
  title String
  dueAt DateTime? @map("due_at")
  status TaskStatus @default(PENDIENTE)
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdByUser User @relation("CaseTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedToUser User? @relation("CaseTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  @@index([caseId, status, dueAt])
  @@index([assignedToUserId, status, dueAt])
  @@map("case_tasks")
}

model Notification {
  id String @id @default(uuid())
  userId String @map("user_id")
  caseId String? @map("case_id")
  type String
  title String
  body String
  readAt DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  case Case? @relation(fields: [caseId], references: [id], onDelete: Restrict)
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model CaseReport {
  id String @id @default(uuid())
  caseId String @map("case_id")
  establishmentId String @map("establishment_id")
  receivedAt DateTime @map("received_at")
  channelCode String @map("channel_code")
  classificationCode String @map("classification_code")
  factualDescription String @map("factual_description")
  background String?
  createdByUserId String @map("created_by_user_id")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  createdByUser User @relation("CaseReportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  @@index([caseId, receivedAt])
  @@map("case_reports")
}

model Participant {
  id String @id @default(uuid())
  establishmentId String @map("establishment_id")
  kind ParticipantKind
  referenceLabel String @map("reference_label")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  caseLinks CaseParticipant[]
  @@index([establishmentId, kind, isActive])
  @@map("participants")
}

model CaseParticipant {
  id String @id @default(uuid())
  caseId String @map("case_id")
  participantId String @map("participant_id")
  participationCode String @map("participation_code")
  linkedByUserId String @map("linked_by_user_id")
  linkedAt DateTime @default(now()) @map("linked_at")
  unlinkedAt DateTime? @map("unlinked_at")
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  linkedByUser User @relation("CaseParticipantLinker", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  @@index([caseId, unlinkedAt])
  @@index([participantId, unlinkedAt])
  @@map("case_participants")
}

model CaseAssignment {
  id String @id @default(uuid())
  caseId String @map("case_id")
  userId String @map("user_id")
  assignedByUserId String @map("assigned_by_user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  reason String?
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  user User @relation("CaseAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedByUser User @relation("CaseAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  @@index([caseId, unassignedAt])
  @@map("case_assignments")
}

model CaseEvent {
  id String @id @default(uuid())
  caseId String @map("case_id")
  actorUserId String? @map("actor_user_id")
  occurredAt DateTime @default(now()) @map("occurred_at")
  eventType CaseEventType @map("event_type")
  previousStatus CaseStatus? @map("previous_status")
  newStatus CaseStatus? @map("new_status")
  previousStageId String? @map("previous_stage_id")
  newStageId String? @map("new_stage_id")
  correlationId String @map("correlation_id")
  relatedEntityType String? @map("related_entity_type")
  relatedEntityId String? @map("related_entity_id")
  metadata Json?
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actorUser User? @relation("CaseEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([caseId, occurredAt, id])
  @@index([correlationId])
  @@map("case_events")
}

model CaseAccessGrant {
  id String @id @default(uuid())
  caseId String @map("case_id")
  userId String @map("user_id")
  accessLevel CaseAccessLevel @map("access_level")
  grantedByUserId String @map("granted_by_user_id")
  grantedAt DateTime @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  reason String?
  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  user User @relation("CaseAccessUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedByUser User @relation("CaseAccessGrantActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  @@unique([caseId, userId])
  @@index([userId, revokedAt, expiresAt])
  @@map("case_access_grants")
}
model Role {
  id String @id @default(uuid())
  name String @unique
  description String?
  users UserRole[]
  permissions RolePermission[]
  @@map("roles")
}
model Permission {
  id String @id @default(uuid())
  code String @unique
  description String?
  roles RolePermission[]
  @@map("permissions")
}
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
  @@id([userId,roleId])
  @@map("user_roles")
}
model RolePermission {
  roleId String @map("role_id")
  permissionId String @map("permission_id")
  role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
  permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade)
  @@id([roleId,permissionId])
  @@map("role_permissions")
}
model Session {
  id String @id @default(uuid())
  userId String @map("user_id")
  tokenHash String @unique @map("token_hash")
  csrfHash String @map("csrf_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
  @@map("sessions")
}
model PasswordResetToken {
  id String @id @default(uuid())
  userId String @map("user_id")
  tokenHash String @unique @map("token_hash")
  purpose String @default("RESET")
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, purpose, usedAt])
  @@map("password_reset_tokens")
}
model SecurityAudit {
  id String @id @default(uuid())
  actorUserId String? @map("actor_user_id")
  action String
  targetType String @map("target_type")
  targetId String? @map("target_id")
  metadata Json?
  changes Json?
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([actorUserId,createdAt])
  @@index([targetType,targetId,createdAt])
  @@map("security_audits")
}
