{
  "name": "backoffice-convivencia-escolar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.14.0",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=9.14.0 <10"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @backoffice/web --filter @backoffice/api dev",
    "build": "pnpm --filter @backoffice/shared build && pnpm --filter @backoffice/web build && pnpm --filter @backoffice/api build",
    "lint": "pnpm --filter @backoffice/web lint && pnpm --filter @backoffice/api lint",
    "typecheck": "pnpm --filter @backoffice/shared typecheck && pnpm --filter @backoffice/web typecheck && pnpm --filter @backoffice/api typecheck",
    "test": "pnpm --filter @backoffice/web test && pnpm --filter @backoffice/api test",
    "db:migrate": "pnpm --filter @backoffice/api prisma:migrate"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.4.0",
      "deepmerge-ts": "8.0.0",
      "effect": "3.20.0",
      "follow-redirects": "1.16.2",
      "js-yaml": "4.3.2",
      "lodash": "4.18.0",
      "multer": "2.5.0",
      "path-to-regexp": "8.4.0",
      "qs": "6.17.1"
    }
  }
}
